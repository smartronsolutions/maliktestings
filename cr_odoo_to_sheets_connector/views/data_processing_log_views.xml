<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_cr_data_processing_log_list" model="ir.ui.view">
        <field name="name">cr.data.processing.log.list</field>
        <field name="model">cr.data.processing.log</field>
        <field name="arch" type="xml">
            <list string="Data Processing Logs" create="0" delete="1">
                <field name="started_at"/>
                <field name="operation_type"/>
                <field name="table_name"/>
                <field name="total_records"/>
                <field name="successful_records"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'partial'"
                       decoration-danger="status == 'failed'"/>
                <field name="duration"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cr_data_processing_log_form" model="ir.ui.view">
        <field name="name">cr.data.processing.log.form</field>
        <field name="model">cr.data.processing.log</field>
        <field name="arch" type="xml">
            <form string="Data Processing Log" create="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="success,partial,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operation Summary">
                            <field name="operation_type" readonly="1"/>
                            <field name="table_name" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                        <group string="Record Metrics">
                            <field name="total_records" readonly="1"/>
                            <field name="successful_records" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details &amp; Reason" name="details">
                            <field name="details" readonly="1" placeholder="Log details and analytical failure reasons..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cr_data_processing_log_search" model="ir.ui.view">
        <field name="name">cr.data.processing.log.search</field>
        <field name="model">cr.data.processing.log</field>
        <field name="arch" type="xml">
            <search string="Search Data Processing Logs">
                <field name="name"/>
                <field name="table_name"/>
                <field name="operation_type"/>
                <filter string="Successful" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Partial Updates" name="filter_partial" domain="[('status', '=', 'partial')]"/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Odoo to Sheet" name="filter_odoo_to_sheet" domain="[('operation_type', '=', 'odoo_to_sheet')]"/>
                <filter string="Sheet to Odoo" name="filter_sheet_to_odoo" domain="[('operation_type', '=', 'sheet_to_odoo')]"/>
                <group>
                    <filter string="Operation Type" name="group_operation_type" context="{'group_by': 'operation_type'}"/>
                    <filter string="Table Name" name="group_table_name" context="{'group_by': 'table_name'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Started At" name="group_started_at" context="{'group_by': 'started_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_cr_data_processing_log" model="ir.actions.act_window">
        <field name="name">Data Processing Logs</field>
        <field name="res_model">cr.data.processing.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cr_data_processing_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data processing logs found.
            </p>
            <p>
                Transaction logs for Google Sheets synchronization will appear here automatically.
            </p>
        </field>
    </record>

</odoo>
